# Rust API origin (server-side only; the browser goes through the /api/v1 proxy).
# Read when `next build` / `next dev` starts - rewrites are compiled at build time.
API_ORIGIN=http://localhost:8080
# Public site URL used for canonical links, sitemap and Open Graph
# Production: https://bizinvox.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
