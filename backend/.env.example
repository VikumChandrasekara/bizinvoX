# Copy to backend/.env for local development. Never commit real secrets.

APP_ENV=development
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://big:big@localhost:5432/big
REDIS_URL=redis://localhost:6379
DB_MAX_CONNECTIONS=20
RUN_MIGRATIONS=true

# Generate each with: openssl rand -base64 48   (must differ from each other)
JWT_SECRET=change-me-dev-only-jwt-secret-0123456789abcdef
TOKEN_SECRET=change-me-dev-only-token-secret-0123456789abcdef

# Public origin of the Next.js frontend (used for CORS, Origin checks, redirect URLs)
APP_ORIGIN=http://localhost:3000
# ALLOWED_ORIGINS=http://127.0.0.1:3000
COOKIE_SECURE=false
# Set true only when a trusted proxy (load balancer / Next.js server) sets X-Forwarded-For
TRUST_PROXY=true

ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=2592000

# Argon2id (OWASP baseline; raise if your latency budget allows)
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# Stripe (test keys for local/staging - never share live keys with staging)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# Email (Resend). Without a key, dev builds log emails instead of sending them.
RESEND_API_KEY=
EMAIL_FROM=bizinvoX.com <no-reply@example.com>

ENABLE_API_DOCS=true
RUST_LOG=big_api=debug,tower_http=info
